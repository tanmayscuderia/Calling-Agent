# =====================================================================
# Multi-Industry WhatsApp AI + Calling Agent Platform — Environment Variables
# Copy to .env and fill in your values.
# =====================================================================

# ---- Server ----
PORT=4000

# ---- Supabase ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Connection string for running migrations via psql
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ---- Org / Member ----
# Default org id (from your organizations table)
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
DEFAULT_MEMBER_ID=00000000-0000-0000-0000-000000000010

# ---- Auth (REQUIRED for login) ----
# Cookie signing secret — generate with: openssl rand -base64 32
# Must be at least 32 characters!
COOKIE_SECRET=calling-agent-dev-secret-change-in-prod-32+chars
# Frontend origin for CORS (must match your Next.js URL)
FRONTEND_ORIGIN=http://localhost:3000

# ---- LLM Provider ----
# deepseek (default) | openai
# DeepSeek uses OpenAI-compatible endpoint: https://api.deepseek.com
LLM_PROVIDER=deepseek

# DeepSeek (primary)
# Get API key: https://platform.deepseek.com/api_keys
# Models: deepseek-v4-flash (fast/cheap) | deepseek-v4-pro (quality)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI (fallback / alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- WhatsApp Bridge ----
WHATSAPP_PROVIDER=baileys
WHATSAPP_SESSION_DIR=.sessions/whatsapp

# ---- AI Behavior ----
AI_AUTO_REPLY=true
AI_IGNORE_GROUPS=true
# Comma-separated phone numbers (digits only, e.g. 919999999999)
AI_ALLOWED_NUMBERS=
AI_BUSINESS_NAME=Demo Realty

# ---- LLM Budget & Eval Guard Rails ----
# Daily LLM API call limit (across all sources). Default: 500
LLM_DAILY_CALL_LIMIT=500
# Separate eval API key (recommended to avoid production cost leaks)
DEEPSEEK_EVAL_KEY=
OPENAI_EVAL_KEY=
# Eval safety: set to true to skip all API calls in eval tests
EVAL_DRY_RUN=false
# Eval safety: set to true in CI to allow eval API calls
EVAL_CONFIRM=false
# Bypass eval cache — force fresh API calls (costs money!)
EVAL_NO_CACHE=false

# ---- Queue & LLM Rate Limiting (Phase C) ----
# Max concurrent LLM calls (prevents 429 rate limits). Default: 3
LLM_MAX_CONCURRENT=3
# Minimum delay between LLM calls in ms. Default: 200
LLM_MIN_DELAY_MS=200
# Queue worker concurrency (jobs processed in parallel). Default: 5
QUEUE_WORKER_CONCURRENCY=5

# ---- Sarvam Voice Calling (docs/SARVAM_CALLING_PLAN.md) ----
# Leave SARVAM_API_KEY empty to disable; /api/calls/start-real returns 400.
# Dashboard: https://apps.sarvam.ai → copy org/workspace/app/connection ids.
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
# Random 32+ char secret embedded in webhook URL path (auth for the webhook)
# Generate: openssl rand -hex 32
SARVAM_WEBHOOK_SECRET=dev-sarvam-webhook-secret-change-me-32chars
# Public HTTPS URL of backend (ngrok URL in dev). Sarvam calls this back.
PUBLIC_BASE_URL=http://localhost:4000
# Calling hours guard, IST (9am-9pm default). start-real rejects outside.
SARVAM_CALLING_HOURS_START=9
SARVAM_CALLING_HOURS_END=21

# ---- Sarvam Inbound Calls (Phase S5) ----
# Approved number customers dial to reach the AI agent. Empty = inbound disabled.
SARVAM_INBOUND_NUMBER=
# Org to attribute inbound webhooks to (they carry no orgId metadata).
SARVAM_DEFAULT_ORG_ID=
# Fallback poller for missed inbound result webhooks (local dev / outages).
SARVAM_INBOUND_POLLER=false
SARVAM_INBOUND_POLL_INTERVAL=120

# ---- WhatsApp Multi-Instance (Phase B) ----
# Auto-boot all connected WhatsApp accounts on server start. Default: true
WHATSAPP_AUTO_BOOT=true
# DEBUG: Process self-messages for testing without a second phone. Default: false
WHATSAPP_SELF_TEST=false

# =====================================================================
# Frontend environment (copy to frontend/.env.local)
# =====================================================================
# NEXT_PUBLIC_API_URL=http://localhost:4000