/**
 * Unit Test: promptEngine
 *
 * These functions build the system prompt, extraction prompt, call prompt,
 * and opening line dynamically from an AgentConfig.
 * A bug here means the LLM gets the wrong instructions → bad replies → lost leads.
 *
 * These are pure functions — no DB calls.
 */
import { describe, it, expect } from 'vitest';
import {
  buildSystemPrompt,
  buildExtractionPrompt,
  buildCallSystemPrompt,
  buildCallOpening,
  CALL_SUMMARY_PROMPT_GENERIC,
} from '../../src/ai/promptEngine';
import type { AgentConfig } from '../../src/ai/agentTypes';

// ── Test fixture ─────────────────────────────────────────

function makeBaseConfig(overrides: Partial<AgentConfig> = {}): AgentConfig {
  return {
    id: 'cfg-1',
    org_id: 'org-1',
    name: 'Real Estate Agent',
    industry: 'real_estate',
    persona_name: 'Priya',
    persona_role: 'real estate sales assistant',
    tone: 'professional',
    business_name: 'Demo Realty',
    business_description: 'Premium real estate developer.',
    business_location: 'Noida',
    system_prompt_override: null,
    qualifying_fields: [
      { key: 'configuration', label: 'Configuration', type: 'string', required_for_qualified: true },
      { key: 'city', label: 'City', type: 'string', required_for_qualified: true },
      { key: 'budget_max', label: 'Max Budget', type: 'number', required_for_qualified: true },
      { key: 'purpose', label: 'Purpose', type: 'enum', options: ['end_use', 'investment', 'rental'] },
    ],
    intent_types: [
      { key: 'property_search', label: 'Property Search' },
      { key: 'callback_request', label: 'Callback Request' },
      { key: 'site_visit', label: 'Site Visit' },
    ],
    status_pipeline: [
      { key: 'new', label: 'New' },
      { key: 'contacted', label: 'Contacted' },
      { key: 'qualified', label: 'Qualified' },
      { key: 'won', label: 'Won' },
    ],
    inventory_enabled: true,
    inventory_table: 'real_estate_units',
    search_fields: [],
    reply_template_match: null,
    reply_template_no_match: null,
    reply_template_missing_info: null,
    call_agent_enabled: true,
    call_opening_template: null,
    is_active: true,
    created_at: '2024-01-01T00:00:00Z',
    updated_at: '2024-01-01T00:00:00Z',
    ...overrides,
  };
}

// ── Tests ────────────────────────────────────────────────

describe('promptEngine', () => {
  // ── buildSystemPrompt ─────────────────────────────────

  describe('buildSystemPrompt', () => {
    it('includes persona name and role', () => {
      const prompt = buildSystemPrompt(makeBaseConfig());
      expect(prompt).toContain('Priya');
      expect(prompt).toContain('real estate sales assistant');
    });

    it('includes business name', () => {
      const prompt = buildSystemPrompt(makeBaseConfig());
      expect(prompt).toContain('Demo Realty');
    });

    it('includes qualifying fields in the prompt', () => {
      const prompt = buildSystemPrompt(makeBaseConfig());
      expect(prompt).toContain('Configuration');
      expect(prompt).toContain('City');
      expect(prompt).toContain('Max Budget');
    });

    it('includes "essential" label for required fields', () => {
      const prompt = buildSystemPrompt(makeBaseConfig());
      expect(prompt).toContain('(essential)');
    });

    it('includes intent types', () => {
      const prompt = buildSystemPrompt(makeBaseConfig());
      expect(prompt).toContain('property_search');
      expect(prompt).toContain('callback_request');
    });

    it('includes status pipeline', () => {
      const prompt = buildSystemPrompt(makeBaseConfig());
      expect(prompt).toContain('New → Contacted');
    });

    it('includes inventory rules when inventory_enabled', () => {
      const prompt = buildSystemPrompt(makeBaseConfig({ inventory_enabled: true }));
      expect(prompt).toContain('never invent');
      expect(prompt).toContain('inventory');
    });

    it('excludes inventory rules when inventory_disabled', () => {
      const prompt = buildSystemPrompt(makeBaseConfig({ inventory_enabled: false }));
      expect(prompt).not.toContain('never invent');
    });

    it('includes "never say generic AI chatbot" instruction', () => {
      const prompt = buildSystemPrompt(makeBaseConfig());
      expect(prompt.toLowerCase()).toContain('never say you are a generic ai chatbot');
    });

    it('includes "never mention database" instruction', () => {
      const prompt = buildSystemPrompt(makeBaseConfig());
      expect(prompt).toContain('Never mention internal database');
    });

    it('uses system_prompt_override when provided', () => {
      const prompt = buildSystemPrompt(
        makeBaseConfig({ system_prompt_override: 'CUSTOM PROMPT for {{business_name}}' })
      );
      expect(prompt).toBe('CUSTOM PROMPT for Demo Realty');
    });

    it('fills template placeholders in override', () => {
      const prompt = buildSystemPrompt(
        makeBaseConfig({
          system_prompt_override: 'Hi I am {{persona_name}} from {{business_name}}',
        })
      );
      expect(prompt).toBe('Hi I am Priya from Demo Realty');
    });

    it('handles empty qualifying_fields', () => {
      const prompt = buildSystemPrompt(makeBaseConfig({ qualifying_fields: [] }));
      expect(prompt).toContain('general enquiry');
    });

    it('handles empty intent_types', () => {
      const prompt = buildSystemPrompt(makeBaseConfig({ intent_types: [] }));
      expect(prompt).toContain('general_question');
    });

    it('defaults business_name to "our company" when null', () => {
      const prompt = buildSystemPrompt(makeBaseConfig({ business_name: null }));
      expect(prompt).toContain('our company');
    });

    it('uses natural tone wording for non-formal', () => {
      const prompt = buildSystemPrompt(makeBaseConfig({ tone: 'friendly' }));
      expect(prompt).toContain('natural and human');
    });

    it('uses professional tone wording for formal', () => {
      const prompt = buildSystemPrompt(makeBaseConfig({ tone: 'formal' }));
      expect(prompt).toContain('professional');
    });
  });

  // ── buildExtractionPrompt ─────────────────────────────

  describe('buildExtractionPrompt', () => {
    it('includes all qualifying field keys in schema', () => {
      const prompt = buildExtractionPrompt(makeBaseConfig());
      expect(prompt).toContain('"configuration"');
      expect(prompt).toContain('"city"');
      expect(prompt).toContain('"budget_max"');
    });

    it('uses "number or null" for number fields', () => {
      const prompt = buildExtractionPrompt(makeBaseConfig());
      expect(prompt).toContain('"budget_max": number or null');
    });

    it('uses enum options for enum fields', () => {
      const prompt = buildExtractionPrompt(makeBaseConfig());
      expect(prompt).toContain('end_use | investment | rental');
    });

    it('includes intent keys from config', () => {
      const prompt = buildExtractionPrompt(makeBaseConfig());
      expect(prompt).toContain('property_search');
      expect(prompt).toContain('callback_request');
      expect(prompt).toContain('site_visit');
    });

    it('includes fixed fields (intent, customer_email, lead_temperature, needs_human)', () => {
      const prompt = buildExtractionPrompt(makeBaseConfig());
      expect(prompt).toContain('"intent"');
      expect(prompt).toContain('"customer_email"');
      expect(prompt).toContain('"customer_phone"');
      expect(prompt).toContain('"lead_temperature"');
      expect(prompt).toContain('"needs_human"');
    });

    it('includes hot temperature rule for callback/visit', () => {
      const prompt = buildExtractionPrompt(makeBaseConfig());
      expect(prompt).toContain('hot');
      expect(prompt).toContain('callback');
    });

    it('includes "return only valid JSON" instruction', () => {
      const prompt = buildExtractionPrompt(makeBaseConfig());
      expect(prompt).toContain('Return only valid JSON');
      expect(prompt).toContain('no markdown fences');
    });

    it('includes "do not guess" rule', () => {
      const prompt = buildExtractionPrompt(makeBaseConfig());
      expect(prompt).toContain('Do not guess');
    });
  });

  // ── buildCallSystemPrompt ─────────────────────────────

  describe('buildCallSystemPrompt', () => {
    it('includes persona and business name', () => {
      const prompt = buildCallSystemPrompt(makeBaseConfig());
      expect(prompt).toContain('Priya');
      expect(prompt).toContain('Demo Realty');
    });

    it('mentions "phone call"', () => {
      const prompt = buildCallSystemPrompt(makeBaseConfig());
      expect(prompt).toContain('phone call');
    });

    it('includes qualifying fields to ask about', () => {
      const prompt = buildCallSystemPrompt(makeBaseConfig());
      expect(prompt).toContain('Configuration');
      expect(prompt).toContain('City');
    });

    it('includes inventory suggestion when enabled', () => {
      const prompt = buildCallSystemPrompt(makeBaseConfig({ inventory_enabled: true }));
      expect(prompt).toContain('matching option');
    });

    it('excludes inventory suggestion when disabled', () => {
      const prompt = buildCallSystemPrompt(makeBaseConfig({ inventory_enabled: false }));
      expect(prompt).not.toContain('matching option');
    });

    it('includes "do not overtalk" instruction', () => {
      const prompt = buildCallSystemPrompt(makeBaseConfig());
      expect(prompt).toContain('overtalk');
    });

    it('includes "do not invent details" instruction', () => {
      const prompt = buildCallSystemPrompt(makeBaseConfig());
      expect(prompt).toContain('Do not invent details');
    });
  });

  // ── buildCallOpening ──────────────────────────────────

  describe('buildCallOpening', () => {
    it('uses default template when no call_opening_template', () => {
      const opening = buildCallOpening(makeBaseConfig({ call_opening_template: null }));
      expect(opening).toContain('Priya');
      expect(opening).toContain('Demo Realty');
      expect(opening).toContain('good time');
    });

    it('uses custom template when provided', () => {
      const opening = buildCallOpening(
        makeBaseConfig({ call_opening_template: 'Hello {{persona_name}} from {{business_name}}' })
      );
      expect(opening).toBe('Hello Priya from Demo Realty');
    });

    it('fills all template placeholders', () => {
      const opening = buildCallOpening(
        makeBaseConfig({ call_opening_template: '{{persona_name}} {{business_name}} {{role}} {{industry}}' })
      );
      expect(opening).toContain('Priya');
      expect(opening).toContain('Demo Realty');
      expect(opening).toContain('real estate sales assistant');
      expect(opening).toContain('real_estate');
    });
  });

  // ── CALL_SUMMARY_PROMPT_GENERIC ───────────────────────

  describe('CALL_SUMMARY_PROMPT_GENERIC', () => {
    it('includes summary schema fields', () => {
      expect(CALL_SUMMARY_PROMPT_GENERIC).toContain('"summary"');
      expect(CALL_SUMMARY_PROMPT_GENERIC).toContain('"outcome"');
      expect(CALL_SUMMARY_PROMPT_GENERIC).toContain('"lead_temperature"');
      expect(CALL_SUMMARY_PROMPT_GENERIC).toContain('"next_follow_up_at"');
      expect(CALL_SUMMARY_PROMPT_GENERIC).toContain('"updated_preferences"');
    });

    it('includes outcome options', () => {
      expect(CALL_SUMMARY_PROMPT_GENERIC).toContain('interested');
      expect(CALL_SUMMARY_PROMPT_GENERIC).toContain('not_interested');
      expect(CALL_SUMMARY_PROMPT_GENERIC).toContain('callback_requested');
      expect(CALL_SUMMARY_PROMPT_GENERIC).toContain('wrong_number');
    });
  });
});